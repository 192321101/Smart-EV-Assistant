<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/cardDark"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/forum_title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Best roadtrip routes in Mumbai?" />

            <TextView
                android:id="@+id/forum_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@color/bgDark"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="ROUTES" />
        </LinearLayout>

        <TextView
            android:id="@+id/forum_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textColorSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:text="Posted by Amit Sharma" />

        <TextView
            android:id="@+id/forum_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textColorPrimary"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:text="Looking for recommendation on DC fast chargers along the Pune highway." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/forum_upvotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:text="▲ 14 Upvotes" />

            <TextView
                android:id="@+id/forum_comments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginStart="16dp"
                android:text="💬 3 Comments" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
