<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgDark"
    android:padding="16dp">

    <TextView
        android:id="@+id/cost_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cost Optimizer"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Current Tariff Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/tariff_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardDark"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/cost_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Grid Rate Status"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tariff_rate_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF-PEAK (Low Cost)"
                android:textColor="@color/colorAccent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tariff_pricing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹10.50 per kWh (Normal: ₹15.50)"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Charges complete before peak rate shift starts in 4 hours."
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Schedule recommendations -->
    <TextView
        android:id="@+id/recommendations_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart Charging Recommendations"
        android:textColor="@color/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tariff_card"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/recommendation_card_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/cardDark"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/recommendations_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Night Owl Savings Plan"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Charge between 00:00 - 05:00. Average rate: ₹9.00/kWh."
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/schedule_charge_btn"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule Slot"
                android:textColor="@color/colorPrimary"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
