<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgDark"
    android:padding="16dp">

    <TextView
        android:id="@+id/analytics_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grid Analytics"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Savings -->
    <androidx.cardview.widget.CardView
        android:id="@+id/savings_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardDark"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/analytics_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Financial Savings"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/savings_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹4,250 Saved"
                android:textColor="@color/textColorPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compared to gasoline running costs over 30 days."
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Environmental impact -->
    <androidx.cardview.widget.CardView
        android:id="@+id/carbon_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardDark"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/savings_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carbon Reduction"
                android:textColor="@color/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/co2_reduction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="125 kg CO2 Saved"
                android:textColor="@color/textColorPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offset by charging from certified eco power supplies."
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Energy metrics -->
    <androidx.cardview.widget.CardView
        android:id="@+id/energy_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardDark"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/carbon_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Energy Consumption"
                android:textColor="@color/accentOrange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/energy_kwh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="342.5 kWh"
                android:textColor="@color/textColorPrimary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total electric energy delivered during slots charge."
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
