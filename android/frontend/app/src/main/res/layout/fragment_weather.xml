<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgDark"
    android:padding="16dp">

    <TextView
        android:id="@+id/weather_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weather Alerts"
        android:textColor="@color/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Current Climate Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/weather_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardDark"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/weather_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local Atmospheric Check"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32°C - Rain Alert"
                android:textColor="@color/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/weather_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Humidity: 78% | UV Index: Low"
                android:textColor="@color/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Active Warnings Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/weather_warning_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cardDark"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/weather_status_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Active Safety Warnings"
                android:textColor="@color/accentOrange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weather_warning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thunderstorms expected near Bandra. Avoid charging at open-air stations for the next 2 hours."
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
